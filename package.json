{
  "name": "aaryan-bakery-sweet-studio",
  "version": "1.0.0",
  "description": "Sweet Studio - Aaryan Bakery Food Ordering, Order Enquiry & AI Chatbot Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && (chmod +x ./node_modules/.bin/* || true) && (npm run build || node ./node_modules/vite/bin/vite.js build)"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.79.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
